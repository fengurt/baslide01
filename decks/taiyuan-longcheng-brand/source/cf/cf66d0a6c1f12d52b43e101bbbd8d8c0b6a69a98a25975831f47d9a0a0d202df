<script>
(function(){
  var deck=document.getElementById('deck'), slides=[].slice.call(deck.querySelectorAll('.slide'));
  var i=0, N=slides.length;
  function fit(){
    var s=Math.min(window.innerWidth/1280,(window.innerHeight-46)/720);
    deck.style.transform='scale('+s+')';
  }
  function show(n,push){
    i=Math.max(0,Math.min(N-1,n));
    slides.forEach(function(el,k){el.classList.toggle('on',k===i);});
    document.getElementById('pgnow').textContent=(i+1);
    document.getElementById('bar').style.width=((i+1)/N*100)+'%';
    if(push!==false) history.replaceState(null,'','#'+(i+1));
    balance(slides[i]);
  }
  function lastLineCount(el){
    var t=el.textContent||''; if(t.length<2) return 99;
    var w=document.createTreeWalker(el,NodeFilter.SHOW_TEXT,null),node=null,last=null;
    while((node=w.nextNode())) last=node;
    if(!last) return 99;
    var full=el.getBoundingClientRect(),r=document.createRange(),c=0,len=last.nodeValue.length;
    for(var k=len;k>0;k--){
      r.setStart(last,k-1); r.setEnd(last,k);
      var rc=r.getBoundingClientRect();
      if(rc.bottom>full.bottom-2 && rc.top>full.bottom-rc.height*1.9) c++; else break;
    }
    return c||99;
  }
  function balance(sl){
    if(!sl||sl.dataset.bal) return;
    sl.querySelectorAll('h1,h2.st,p.sl,.part .sub').forEach(function(el){
      var base=parseFloat(getComputedStyle(el).fontSize), sz=base, n=0;
      while(lastLineCount(el)<=1 && n<14){ sz*=0.972; el.style.fontSize=sz.toFixed(2)+'px'; n++; }
      if(n===0) el.style.fontSize='';
    });
    sl.dataset.bal='1';
  }
  document.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '||e.key==='ArrowDown'){show(i+1);e.preventDefault();}
    else if(e.key==='ArrowLeft'||e.key==='PageUp'||e.key==='ArrowUp'){show(i-1);e.preventDefault();}
    else if(e.key==='Home'){show(0);} else if(e.key==='End'){show(N-1);}
    else if(e.key==='f'||e.key==='F'){ if(!document.fullscreenElement){document.documentElement.requestFullscreen&&document.documentElement.requestFullscreen();} else {document.exitFullscreen();} }
    else if(/^[0-9]$/.test(e.key)){ buf+=e.key; clearTimeout(bt); bt=setTimeout(function(){show(parseInt(buf,10)-1);buf='';},520); }
  });
  var buf='',bt;
  document.querySelector('.tapz.l').addEventListener('click',function(){show(i-1);});
  document.querySelector('.tapz.r').addEventListener('click',function(){show(i+1);});
  var x0=null;
  document.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});
  document.addEventListener('touchend',function(e){
    if(x0===null) return; var dx=e.changedTouches[0].clientX-x0;
    if(Math.abs(dx)>46) show(i+(dx<0?1:-1)); x0=null;},{passive:true});
  window.addEventListener('resize',fit);
  document.getElementById('pgall').textContent=N;
  fit();
  var h=parseInt((location.hash||'#1').slice(1),10);
  show(isNaN(h)?0:h-1,false);
})();
</script>
